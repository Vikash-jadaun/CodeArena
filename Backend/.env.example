# HTTP server
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Atlas
DB_CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster>/<database>

# JWT signing key (use a long, random value outside local development)
JWT_SECRET=replace-with-a-long-random-secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASS=replace-with-redis-password

# Judge0
JUDGE0_URL=https://ce.judge0.com

# Google Gemini
GEMINI_KEY=replace-with-gemini-api-key

# Cloudinary signed upload pipeline
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
